{
  "name": "electron-container",
  "productName": "Smart Clock",
  "version": "1.0.0",
  "description": "Windows kiosk container for the Smart Clock PWA",
  "private": true,
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run type-check && npm run test",
    "icon": "node scripts/make-icon.mjs",
    "pack:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "electron": "43.0.0",
    "electron-builder": "26.0.12",
    "png-to-ico": "2.1.8",
    "sharp": "0.34.1",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.betknesset.smartclock",
    "productName": "Smart Clock",
    "asar": true,
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "static/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SmartClockSetup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Smart Clock",
      "uninstallDisplayName": "Smart Clock ${version}",
      "include": "build/installer.nsh"
    }
  }
}
