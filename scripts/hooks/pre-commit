#!/bin/sh
# Auto-bump patch version of electron-container/package.json on each commit
# that includes changes inside the electron-container/ directory.
#
# Install: copy this file to .git/hooks/pre-commit (or symlink it).
# On Windows (Git Bash): cp scripts/hooks/pre-commit .git/hooks/pre-commit

PKG="electron-container/package.json"

# Only bump if the commit touches electron-container files
STAGED=$(git diff --cached --name-only)
echo "$STAGED" | grep -q "^electron-container/" || exit 0

# Skip if package.json isn't tracked (shouldn't happen, but safety)
[ -f "$PKG" ] || exit 0

# Read current version, bump patch
CURRENT=$(node -p "require('./$PKG').version")
MAJOR=$(echo "$CURRENT" | cut -d. -f1)
MINOR=$(echo "$CURRENT" | cut -d. -f2)
PATCH=$(echo "$CURRENT" | cut -d. -f3)
NEW_PATCH=$((PATCH + 1))
NEW_VERSION="$MAJOR.$MINOR.$NEW_PATCH"

# Update package.json in-place using node (preserves formatting)
node -e "
const fs = require('fs');
const path = './$PKG';
let content = fs.readFileSync(path, 'utf8');
content = content.replace(/\"version\": \"$CURRENT\"/, '\"version\": \"$NEW_VERSION\"');
fs.writeFileSync(path, content);
"

# Also update package-lock.json if it exists
LOCK="electron-container/package-lock.json"
if [ -f "$LOCK" ]; then
  node -e "
  const fs = require('fs');
  let content = fs.readFileSync('$LOCK', 'utf8');
  const pkg = JSON.parse(content);
  if (pkg.version) pkg.version = '$NEW_VERSION';
  if (pkg.packages && pkg.packages['']) pkg.packages[''].version = '$NEW_VERSION';
  fs.writeFileSync('$LOCK', JSON.stringify(pkg, null, 2) + '\n');
  "
  git add "$LOCK"
fi

# Stage the bumped package.json
git add "$PKG"

echo "Auto-bumped electron-container version: $CURRENT → $NEW_VERSION"
